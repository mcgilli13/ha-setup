          "config": {
            "alias": "EV Ladestrom dynamisch anpassen",
            "id": "ev_ladestrom_dynamisch",
            "mode": "single",
            "trigger": [
              {
                "platform": "time_pattern",
                "seconds": "/30"
              }
            ],
            "condition": [
              {
                "condition": "state",
                "entity_id": "sensor.evc_status_code",
                "state": "2"
              }
            ],
            "action": [
              {
                "variables": {
                  "optimal_strom": "{{ states('sensor.ev_ladestrom_optimal') | float(0) }}",
                  "aktueller_strom": "{{ states('input_number.ev_ladestrom') | float(0) }}",
                  "zwang_aktiv": "{{ is_state('input_boolean.ev_force_charging', 'on') }}"
                }
              },
              {
                "condition": "template",
                "value_template": "{{ (optimal_strom - aktueller_strom) | abs > 0.5 }}"
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ optimal_strom == 0 and not zwang_aktiv }}"
                      }
                    ],
                    "sequence": [
                      {
                        "data": {
                          "hub": "solax_evc",
                          "unit": 1,
                          "address": 1575,
                          "value": 3
                        },
                        "action": "modbus.write_register"
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ optimal_strom > 0 or zwang_aktiv }}"
                      }
                    ],
                    "sequence": [
                      {
                        "target": {
                          "entity_id": "input_number.ev_ladestrom"
                        },
                        "data": {
                          "value": "{% if optimal_strom > 0 %}\n  {{ optimal_strom }}\n{% else %}\n  16\n{% endif %}\n"
                        },
                        "action": "input_number.set_value"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KCZWHTBMEQSAHR3SVQQ15MR9",
            "parent_id": null,
            "user_id": null
          }
        },
