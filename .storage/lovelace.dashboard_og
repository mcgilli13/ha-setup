{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.dashboard_og",
  "data": {
    "config": {
      "views": [
        {
          "title": "Home",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "2.OG",
                  "heading_style": "title"
                },
                {
                  "square": true,
                  "type": "grid",
                  "cards": [
                    {
                      "type": "entity",
                      "entity": "sensor.solax_ac_power",
                      "name": "Solarpanels"
                    },
                    {
                      "type": "entity",
                      "entity": "sensor.micha_strompreis",
                      "name": "Strompreis"
                    },
                    {
                      "type": "entity",
                      "entity": "sensor.shellypro3em_a0dd6ca16768_total_active_power",
                      "name": "aktueller Vrbr"
                    },
                    {
                      "type": "entity",
                      "name": "monatl.Vrbr",
                      "entity": "sensor.shellypro3em_monthly_energy"
                    }
                  ],
                  "columns": 2
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Strompreis",
                  "heading_style": "title"
                },
                {
                  "type": "custom:apexcharts-card",
                  "experimental": {
                    "color_threshold": true
                  },
                  "all_series_config": {
                    "unit": "Cent/kWh"
                  },
                  "apex_config": {
                    "grid": {
                      "show": true,
                      "borderColor": "#E0E0E0"
                    },
                    "chart": {
                      "height": "250px"
                    },
                    "tooltip": {
                      "enabled": true,
                      "followCursor": false,
                      "x": {
                        "show": false
                      },
                      "fixed": {
                        "enabled": true
                      }
                    }
                  },
                  "header": {
                    "show": true,
                    "title": "Strompreis",
                    "show_states": true,
                    "colorize_states": true,
                    "standard_format": false
                  },
                  "update_interval": "15min",
                  "graph_span": "48h",
                  "now": {
                    "show": true,
                    "color": "9E9E9E"
                  },
                  "span": {
                    "start": "day"
                  },
                  "series": [
                    {
                      "entity": "sensor.tibber_prices",
                      "name": "Preis",
                      "show": {
                        "in_header": "before_now",
                        "name_in_header": false
                      },
                      "color_threshold": [
                        {
                          "value": 0,
                          "color": "4DD0E1"
                        },
                        {
                          "value": 20,
                          "color": "26A69A"
                        },
                        {
                          "value": 25,
                          "color": "4CAF50"
                        },
                        {
                          "value": 30,
                          "color": "7CB342"
                        },
                        {
                          "value": 35,
                          "color": "FBC02D"
                        },
                        {
                          "value": 40,
                          "color": "EF6C00"
                        },
                        {
                          "value": 45,
                          "color": "B71C1C"
                        }
                      ],
                      "type": "line",
                      "curve": "stepline",
                      "extend_to": false,
                      "stroke_width": 2,
                      "float_precision": 2,
                      "data_generator": "const noon = new Date()\nnoon.setHours(0, 0, 0, 0)\nconst prices = entity.attributes.today.concat(entity.attributes.tomorrow);\nconst data = [];\nfor(let i = 0; i < prices.length; i++) {\n  data.push([noon.getTime() + i * 1000 * 3600, prices[i].total * 100])\n}\nreturn data;\n"
                    }
                  ]
                },
                {
                  "show_current": true,
                  "show_forecast": true,
                  "type": "weather-forecast",
                  "entity": "weather.singen",
                  "forecast_type": "daily"
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "path": "eingang",
          "title": "Eingang",
          "cards": [
            {
              "camera_view": "live",
              "alert_classes": [
                "motion",
                "moisture"
              ],
              "sensor_classes": [
                "temperature",
                "humidity"
              ],
              "features_position": "bottom",
              "display_type": "camera",
              "type": "area",
              "area": "outside",
              "color": ""
            }
          ]
        },
        {
          "type": "sections",
          "max_columns": 4,
          "title": "Wetter",
